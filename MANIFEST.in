include README.md CONTRIBUTING.md SECURITY.md LICENSE NOTICE
include AGENTS.md pyproject.toml setup.py MANIFEST.in install.py install.sh
recursive-include .github/workflows *.yml
recursive-include docs *.md *.1 *.texi *.info
include docs/mockups/web-manager.html
recursive-include docs/assets *.png
include docs/assets/tui/manifest.json
include completions/oc-box
recursive-include src *.py *.js *.css *.tsx
include src/oc_box/oc-box-mark.svg src/oc_box/oc-box-mark.png
recursive-include tests *.py *.mjs
include tools/host_sandbox.js
recursive-include tools/native_plugins *.js
recursive-include tools *.py
global-exclude *.py[cod]

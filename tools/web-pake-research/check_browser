    ("changed-reply-context", (START,), (1, 1, 0), [True], (False, None)),
    ("changed-ke2", (START,), (1, 1, 1), [True], (False, None)),
    ("binding-accessor", (START,), (1, 1, 1), [True], (False, None)),
    ("changed-proof", (START, ("/finish", 403)), (1, 1, 1), [True], (False, None)),
    ("out-of-scope", (START,), (1, 1, 1), [True], (False, None)),

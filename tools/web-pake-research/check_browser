def run_case(api, worker_fd, seed_fd, assets, spec, size=37):
    mode, traffic, counts, cleanup, ticket = spec
    origins = web_local_origins.LocalOrigins(9443, 9444) if size == 37 else (
        web_local_origins.LocalOrigins(9741, 9742))
    name = "synthetic-first" if size == 37 else "synthetic-second"
    setup, record = seed_account(seed_fd, origins, name, size)
    scope = ("a" * 32,) if mode == "out-of-scope" else (WORKSPACE,)
    store = web_accounts.AccountStore(setup, (web_accounts.Account(name, scope, record),))
    binding = web_admission.WebBinding(WORKSPACE, "synthetic-owner", origins.workspace.value)
    backend = web_pake_profile.LocalPakeProfile(
        worker_fd, expected_sha256=bytes.fromhex(WORKER_SHA), origins=origins)
    flow = web_pake_flow.PakeFlow(
        binding, store=store, backend=backend, sizes=backend.sizes, auth_origin=origins.account.value)
    native_calls = []
    sign_in = web_named_local.LocalNamedSignIn(
        origins=origins, binding=binding, flow=flow, owner_current=lambda candidate: candidate == binding,
        pair_native=lambda *args: native_calls.append(True),
    )
    ingress = web_account_ingress.AccountIngress(
        origins=origins, sign_in=sign_in, translate_nonce=lambda cookie: NONCE if cookie == COOKIE else None)
    route = AccountRoute(origins, ingress, assets, mode, name)
    try:
        with browser_document(api, route, origins.account.value) as session:
            config = json.dumps(dict(username=name, mode=mode, size=size,
                                     accountOrigin=origins.account.value, workspaceOrigin=origins.workspace.value))
            tested = api.call("Runtime.evaluate", {
                "expression": "(async () => { for (let i=0; i<100 && !globalThis.exercise; i++) "
                              "await new Promise(r=>setTimeout(r,25)); "
                              f"return exercise({config}); }})()",
                "awaitPromise": True, "returnByValue": True,
            }, session)
            require("exceptionDetails" not in tested, "browser fixture execution failed")
            result = tested["result"]["value"]
            require((result["ticket"], result.get("taken")) == ticket and
                    (not ticket[0] or result["singleUse"] is True), "unexpected ticket outcome")
            require(tuple(result[key] for key in ("opened", "reads", "finishes")) == counts and
                    result["cleanup"] == cleanup, "attempt ownership or cleanup mismatch")
            require(result["cleared"] and result["immutable"] and result["reuseRefused"] and
                    not result["accessorCalled"], "slot input or one-use contract mismatch")
            if mode == "entropy-trap":
                require(result["entropy"] == 1, "entropy trap not observed")
            elif mode in ("pre-aborted", "over-scrub-limit"):
                require(result["entropy"] == 0, "refused input reached WASM entropy")
            require(tuple(route.calls) == traffic and not native_calls, "unexpected account traffic or pairing")
            outstanding = int(traffic == (START,))
            require(len(backend._worker._active) == outstanding, "unexpected live verifier state")
    finally:
        try:
            sign_in.close()
        finally:
            closed = backend.close()
        require(closed and not flow.cleanup_failed and flow.active_verifiers == 0,
                "worker cleanup not confirmed")
    print(f"PASS {mode} {size} bytes, {len(traffic)} protocol POST(s)", flush=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("build_dir", type=Path)
    parser.add_argument("chromium", type=Path, help="already installed pinned headless-shell binary")
    args = parser.parse_args()
    network_off()
    build = args.build_dir.resolve(strict=True) / "target"
    chrome = args.chromium.resolve(strict=True)
    with chrome.open("rb") as stream:
        require(hashlib.file_digest(stream, "sha256").hexdigest() == CHROME_SHA, "Chromium hash mismatch")
    worker = pinned(build / "release/ocop-worker", 524_480, WORKER_SHA)
    seed = pinned(build / "release/ocop-fixture", 559_216, SEED_SHA)
    wasm = pinned(build / "wasm32-unknown-unknown/release/ocop-browser.wasm", 204_179, WASM_SHA)
    adapter = pinned(ROOT / "src/oc_box/web_pake_client.mjs", 12_182, ADAPTER_SHA)
    assets = {
        "/fixture": ("text/html", PAGE),
        "/fixture.mjs": ("text/javascript", (HERE / "browser_fixture.mjs").read_bytes()),
        "/adapter.mjs": ("text/javascript", adapter),
        "/slot.mjs": ("text/javascript", (HERE / "browser_slot.mjs").read_bytes()),
        "/client.wasm": ("application/wasm", wasm),
        "/favicon.ico": ("text/plain", b""),
    }
    with sealed(worker) as worker_fd, sealed(seed) as seed_fd:
        with TemporaryDirectory(prefix="ocop-cdp-") as profile, chromium(chrome, profile) as api:
            require(api.call("Browser.getVersion")["product"] == PRODUCT, "Chromium product mismatch")
            print(PRODUCT, flush=True)
            for spec in CASES:
                run_case(api, worker_fd, seed_fd, assets, spec, 1024 if spec[0] == "oversized" else 37)
            run_case(api, worker_fd, seed_fd, assets, CASES[0], 1024)
    print("ALL PASS: targets and verifiers drained; Chromium exited; temporary profile removed")


if __name__ == "__main__":
    main()
